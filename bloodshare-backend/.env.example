APP_NAME="Aïma"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# 📖 Pacific/Noumea (pas UTC) : now() dans les commandes planifiées (journée mondiale,
# veille d'événement, rappels datés...) doit calculer "aujourd'hui"/"demain" dans le fuseau
# du public visé (Nouvelle-Calédonie), sinon les dates sont décalées d'une journée.
APP_TIMEZONE=Pacific/Noumea
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Valeurs du docker-compose.yml (service "db"). Pour un autre environnement, les surcharger.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=bloodshare
DB_USERNAME=bloodshare
DB_PASSWORD=bloodshare123

# Super admin créé par le seeder au premier lancement (docker compose : RUN_SEEDERS=true).
# LOCAL UNIQUEMENT : changer le mot de passe si l'instance est exposée. Laisser
# SEED_ADMIN_PASSWORD vide pour en générer un aléatoire (affiché une seule fois dans les logs).
SEED_ADMIN_EMAIL=admin@bloodshare.local
SEED_ADMIN_PSEUDO=SuperAdmin
SEED_ADMIN_PASSWORD=Admin-local-1234

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
# Canal de log dédié, toujours à debug quel que soit LOG_LEVEL : sans ça, un LOG_LEVEL=error
# (production) filtre les emails écrits par le mailer 'log' — voir config/logging.php.
MAIL_LOG_CHANNEL=mail
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Notifications push web (PWA). Générer ses propres clés par environnement avec
# `docker exec -it bloodshare_backend php artisan webpush:vapid` — jamais commiter de vraies clés.
# VAPID_SUBJECT est obligatoire (mailto: ou URL) : sans lui, FCM rejette l'envoi en silence
# et le abonnement en échec est supprimé automatiquement — aucune erreur visible côté Laravel.
VAPID_SUBJECT=mailto:contact@bloodshare.local
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
